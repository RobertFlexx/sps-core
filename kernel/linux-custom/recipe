name        linux-custom
version     7.2.2
release     1
description linux-custom: SPS Linux (Splux) kernel from /etc/sps/kernel.config

source      https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-${version}.tar.xz
hash        sha256:7d0e7ce14f98c43efe880cffbf354a59be45928fdf7170d7333c374ae91c0d83

depend      filesystem
depend      kmod
depend      busybox

configure   if [ -f "${SPS_ROOT:-/}/etc/sps/kernel.config" ]; then cp "${SPS_ROOT:-/}/etc/sps/kernel.config" .config; else make defconfig; fi
configure   make olddefconfig
build       make -j"$MAKEJOBS"
install     make INSTALL_MOD_PATH="$PKG" INSTALL_PATH="$PKG/boot" modules_install
install     mkdir -p "$PKG/boot"
install     cp arch/x86/boot/bzImage "$PKG/boot/vmlinuz-custom-7.2.2"
