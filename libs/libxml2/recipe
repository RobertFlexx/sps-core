name        libxml2
version     2.15.0
release     2
description libxml2: XML toolkit

source      https://download.gnome.org/sources/libxml2/2.15/libxml2-2.15.0.tar.xz
hash        sha256:5abc766497c5b1d6d99231f662e30c99402a90d03b06c67b62d6c1179dedd561

depend      filesystem
depend      zlib
builddep    meson
builddep    ninja

configure   meson setup build --prefix=/usr --libdir=lib64 --buildtype=release -Dpython=disabled -Ddocs=disabled -Dzlib=enabled -Dicu=disabled
