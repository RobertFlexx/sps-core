name        dbus
version     1.16.2
release     4
description dbus: message bus

source      https://dbus.freedesktop.org/releases/dbus/dbus-1.16.2.tar.xz
hash        sha256:0ba2a1a4b16afe7bceb2c07e9ce99a8c2c3508e5dec290dbb643384bd6beb7e2

depend      filesystem
depend      expat
builddep    meson
builddep    ninja

configure   meson setup build --prefix=/usr --libdir=lib64 --buildtype=release -Dsystemd=disabled -Dselinux=disabled
build       meson compile -C build
install     DESTDIR="$PKG" meson install -C build --no-rebuild
install     mkdir -p "$PKG/usr/lib/systemd/system" "$PKG/etc/init.d" "$PKG/etc/sv/dbus" "$PKG/etc/s6/sv/dbus" "$PKG/etc/dinit.d" "$PKG/etc/shepherd.d" "$PKG/etc/rc.d/init.d"
install     install -m 0644 "$SRC/files/dbus.service" "$PKG/usr/lib/systemd/system/dbus.service"
install     install -m 0755 "$SRC/files/openrc-dbus" "$PKG/etc/init.d/dbus"
install     install -m 0755 "$SRC/files/runit-dbus" "$PKG/etc/sv/dbus/run"
install     install -m 0755 "$SRC/files/s6-dbus" "$PKG/etc/s6/sv/dbus/run"
install     install -m 0644 "$SRC/files/dinit-dbus" "$PKG/etc/dinit.d/dbus"
install     install -m 0644 "$SRC/files/shepherd-dbus.scm" "$PKG/etc/shepherd.d/dbus.scm"
install     install -m 0755 "$SRC/files/sysvinit-dbus" "$PKG/etc/rc.d/init.d/dbus"
